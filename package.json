{
  "name": "dc5-fantasy-hub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src worker/src scripts/tests/fpl-live-pipeline.test.ts --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:analytics": "tsx scripts/tests/analytics-decision-engine.test.ts",
    "test:fpl": "tsx scripts/tests/fpl-live-pipeline.test.ts",
    "test": "npm run test:fpl",
    "dev:worker": "wrangler dev --config worker/wrangler.toml",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "type-check:worker": "tsc -p worker/tsconfig.json",
    "sync:fpl": "tsx scripts/sync/index.ts",
    "sync:data:fpl": "tsx scripts/sync/index.ts",
    "sync:bootstrap": "tsx scripts/sync/bootstrap.sync.ts",
    "sync:asean": "node --dns-result-order=ipv4first --import tsx scripts/sync/asean.sync.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "terser": "^5.49.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.5",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "country-flag-icons": "^1.6.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1"
  }
}
